ImperfectPage: {
	DisplayName: Imperfect Page
	Tooltip:
		'''
		Teleports the Recorder to you at any time
		Activate via [c/FF0000:right-click in inventory], then [c/FF0000:right-click a bullet-type ammo] to switch the Recorder's ammo
		'''
