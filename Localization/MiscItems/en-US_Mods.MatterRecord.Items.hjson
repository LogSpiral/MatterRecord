EternalWine: {
	DisplayName: Eternal Wine
	Tooltip:
		'''
		Borrows {0} life and grants {1}s of invincibility
		After consumption, natural life regeneration repays the borrowed life
		Can be triggered with Quick Heal or Quick Buff, prioritizing healing potions
		Usable even while afflicted with Potion Sickness
		"A sublime yet corrupting nectar, akin to divine ambrosia."
		'''
	UnlockHardMode: Gains a boost in Hardmode
	UnlockMoonLord: Gains a boost after defeating the Moon Lord
	RestoreLifeText: Restore Life
	LifeDebt: Life to compensate
}

TurtleAmulet: {
	DisplayName: Tortoise Amulet
	Tooltip:
		'''
		While equipped, tortoises will not pester you
		Best not to take it off...
		'''
}

TortoiseShell: {
	DisplayName: Giant Tortoise Shell
	Tooltip:
		'''
		Hold left-click to retract into the shell and charge for up to 3s before launching
		Gain heavy damage reduction while charging
		Launch speed depends on the charge time
		Damage depends on launch speed and launch angle
		"The perfect choice for ramming into your friends"
		'''
}

ZenithBoulder: {
	DisplayName: Zenith Boulder
	Tooltip: I bet the Creator would love this
	Sisyphus: Sisyphus
}

EtherChest: {
	DisplayName: Ether Chest
