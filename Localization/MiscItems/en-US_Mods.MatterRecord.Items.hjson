	NoAmmo: No ammo
}

SystemControlSword: {
	DisplayName: System Control Sword
	Tooltip:
		'''
		Open the keybind page when swung
		Deals extra damage on hit
		"Who changed my keybinds?"
		'''
}

TodaySword: {
	DisplayName: Today's Sword
	Tooltip:
		'''
		Each day it randomly inherits all the effects of one sword
		Spend a free charge to try it; right-click to watch an ad and gain free charges
		"Today's free charges have been used up"
		'''
	AdUITitle:
		'''
		Today's Sword
		Ad space for rent
		'''
	CurrentSwordText: Currently mimicking: {0}
	SwordNotSelectedText: Today's sword has not been chosen yet, waiting until 4:00 AM...
	FreeChargesText: Free charges: {0}/{1}
	AdCooldownText: (ad cooldown: {0}s)
	RightClickHint: Right-click to open the ad panel (30s cooldown, gain 1 free charge)
}

TimeSword: {
	DisplayName: Time Sword
	Tooltip:
		'''
		Increases damage based on your character's saved play time
		Using it reduces your saved play time
		"I don't have time to play Terraria..."
		'''
	CantLoadPlayerFile: Couldn't retrieve player save data.
	CurrentPlayTime: Current play time: {0} seconds ({1})
	NotEnoughTime: Too little time ({0}s, need over 120s), no time spent
}

