EternalWine: {
	DisplayName: 永生之酒
	Tooltip:
		'''
		借贷{0}生命并获得{1}秒无敌帧
		饮用后你的生命恢复将用于偿还所借贷的生命
		可通过快速治疗键与快速增益键触发，优先使用治疗药水
		药水疾病时也可使用
		“使人升华，却又引人堕落，除了所谓的神酒，还有什么呢？”
		'''
	UnlockHardMode: 困难模式时获得提升
	UnlockMoonLord: 击败月球领主获得提升
	RestoreLifeText: 恢复生命
	LifeDebt: 待偿还生命值
}

TurtleAmulet: {
	DisplayName: 陆龟护身符
	Tooltip:
		'''
		装备时，使你免受陆龟的侵扰
		最好不要取下它
		'''
}

Bookmark: {
	DisplayName: 书签
	Tooltip:
		'''
		+3%移速
		+5%伤害
		获得一个事象记录专用饰品栏
		'''
}

EternalBookmark: {
	DisplayName: 永恒书签
	Tooltip:
		'''
		永久获得一个事象记录专用饰品栏
		'''
}


TortoiseShell: {
	DisplayName: 巨型陆龟壳
	Tooltip:
		'''
		长按左键缩进龟壳，蓄力至多3s之后可发射
		蓄力时获得高额减伤
		根据蓄力时间决定发射速度
		发射速度与发射角决定伤害
		“和好友对撞的绝佳选择”
		'''
}

ZenithBoulder: {
	DisplayName: 天顶巨石
	Tooltip: “我猜创世神肯定会喜欢这个”
	Sisyphus: 西西弗斯
}

EtherChest: {
	DisplayName: 以太宝箱
	Tooltip: 容积是边长为两个物块的正十二面体的体积
}

CosmosScissors: {
	DisplayName: 鸿蒙剪刀
	Tooltip: “裁剪空间...抱歉做不到”
}

CantSeword: {
	DisplayName: 看不剑
	Tooltip: “真正的真空刃！”
}

ProtagonistAura: {
	DisplayName: 主角光环
	Tooltip:
		'''
