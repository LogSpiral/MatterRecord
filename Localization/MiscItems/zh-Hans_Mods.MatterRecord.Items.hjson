RecordUnlockPill: {
	DisplayName: 记录解锁胶囊
	Tooltip:
		'''
		播放解锁动画
		[调试用物品]
		"我们曾考虑动画结束在头顶生成一个巨石"
		'''
}

ImperfectPage: {
	DisplayName: 碎纸页
	Tooltip:
		'''
		无论何时，将记录者传送至你身旁
		在[c/FF0000:背包内右键]激活后[c/FF0000:右键某个子弹类弹药]使记录者更换弹药
		'''
	CurrentAmmo: 当前记录子弹：{0}
	NoAmmo: 无子弹
}

SystemControlSword: {
	DisplayName: 系统控剑
	Tooltip:
		'''
		挥动时打开控键绑定页面
		命中时造成额外伤害
		“谁把我键位改了？”
		'''
}

TodaySword: {
	DisplayName: 今日推剑
	Tooltip:
		'''
		每天随机继承一把剑的所有效果
		可消耗免费次数进行体验，右键观看广告以获取免费次数
		“今日免费次数已用完”
		'''
	AdUITitle:
		'''
		今日推剑
		广告位招租
		'''
	CurrentSwordText: 当前模仿：{0}
	SwordNotSelectedText: 今日的剑尚未选定，等待凌晨4:00...
	FreeChargesText: 免费次数：{0}/{1}
	AdCooldownText: (广告冷却：{0}秒)
	RightClickHint: 右键打开广告面板（冷却30秒，获得1免费次数）
}

TimeSword: {
	DisplayName: 游戏时剑
	Tooltip:
		'''
		根据角色存档时间增强伤害
		使用时减少存档时间
		“我没有时间玩泰拉了……”
		'''
	CantLoadPlayerFile: 无法获取玩家存档信息
	CurrentPlayTime: 存档时间: {0} 秒 ({1})
	NotEnoughTime: 时间过少（{0}秒 ≤ 120），未消耗时间
}

HundredHerbsBrew: {
	DisplayName: 百草酿
	Tooltip:
		'''
		获得百草生香
		需要以正确的方式饮下才能生效
		'''
}
